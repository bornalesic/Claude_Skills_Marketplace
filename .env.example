# Copy to .env.local (scripts/setup-worktrees.sh does this per worktree).
# Never commit .env.local. Full reference: docs/contracts/env.md

NODE_ENV=development
WORKSTREAM=main
WEB_PORT=3000
MCP_PORT=3001
APP_URL=http://localhost:3000
MCP_URL=http://localhost:3001/mcp
DATABASE_URL=postgres://upskillzz:upskillzz@localhost:5432/upskillzz
LOG_LEVEL=info

# Auth (Better Auth in apps/web)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEV_LOGIN_ENABLED=true

# Token verification in apps/mcp (W1 confirms exact values)
AUTH_ISSUER=http://localhost:3000/api/auth
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
RATE_LIMIT_PER_MIN=60

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Content
CONTENT_INCLUDE_SAMPLES=true

# Optional
SENTRY_DSN=
